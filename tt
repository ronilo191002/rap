task.spawn(function()
    local last = ""

    while State.Running
        and Gui.Parent
    do
        task.wait(0.1)

        local snapshot = {}

        for name, enabled
            in pairs(
                FruitSelectedDisplay
            )
        do
            if enabled then
                snapshot[
                    #snapshot + 1
                ] = name
            end
        end

        table.sort(snapshot)

        local current =
            table.concat(
                snapshot,
                "|"
            )

        if current ~= last then
            last = current

            syncFruitConfig()
        end
    end
end)

