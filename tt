--------------------------------------------------
-- DISCOVER MUTATIONS
--------------------------------------------------

local function addMutation(
    mutations,
    name
)
    if not name then
        return
    end

    name =
        trim(
            tostring(name)
        )

    if name == ""
        or name == "Normal"
        or name == "None"
    then
        return
    end

    mutations[name] = true
end

local function addMutationValue(
    mutations,
    value
)
    local list =
        parseMutations(value)

    for _, name in ipairs(list) do
        addMutation(
            mutations,
            name
        )
    end
end

local function scanMutationTable(
    source,
    mutations,
    depth,
    visited
)
    depth = depth or 0
    visited = visited or {}

    if depth > 6 then
        return
    end

    if typeof(source) ~= "table" then
        return
    end

    if visited[source] then
        return
    end

    visited[source] = true

    for key, value in pairs(source) do
        --------------------------------------------------
        -- mutation table keys often look like:
        -- Basa = {...}
        -- Golden = {...}
        --------------------------------------------------

        if typeof(key) == "string" then
            local lower =
                key:lower()

            if lower ~= "mutations"
                and lower ~= "mutation"
                and lower ~= "name"
                and lower ~= "displayname"
                and lower ~= "multiplier"
                and lower ~= "chance"
                and lower ~= "color"
            then
                if typeof(value) == "table" then
                    if value.Multiplier
                        or value.Chance
                        or value.Color
                        or value.DisplayName
                        or value.Name
                    then
                        addMutation(
                            mutations,
                            value.DisplayName
                                or value.Name
                                or key
                        )
                    end
                end
            end

            if lower:find(
                "mutation",
                1,
                true
            ) then
                if typeof(value)
                    == "string"
                then
                    addMutationValue(
                        mutations,
                        value
                    )
                end
            end
        end

        if typeof(value) == "table" then
            scanMutationTable(
                value,
                mutations,
                depth + 1,
                visited
            )
        end
    end
end

local function discoverMutations()
    local mutations = {}

    --------------------------------------------------
    -- LIVE FRUITS
    --------------------------------------------------

    local plants = getPlants()

    if plants then
        for _, obj in ipairs(
            plants:GetDescendants()
        ) do
            if obj:GetAttribute(
                "FruitId"
            ) ~= nil then
                addMutationValue(
                    mutations,
                    obj:GetAttribute(
                        "Mutations"
                    )
                )
            end
        end
    end

    --------------------------------------------------
    -- BACKPACK CROPS
    --------------------------------------------------

    local backpack =
        Player:FindFirstChild(
            "Backpack"
        )

    if backpack then
        for _, obj in ipairs(
            backpack:GetChildren()
        ) do
            if obj:IsA("Tool")
                and obj:GetAttribute(
                    "CropName"
                )
            then
                addMutationValue(
                    mutations,
                    obj:GetAttribute(
                        "Mutations"
                    )
                )
            end
        end
    end

    --------------------------------------------------
    -- CHARACTER HELD CROPS
    --------------------------------------------------

    local character =
        Player.Character

    if character then
        for _, obj in ipairs(
            character:GetChildren()
        ) do
            if obj:IsA("Tool")
                and obj:GetAttribute(
                    "CropName"
                )
            then
                addMutationValue(
                    mutations,
                    obj:GetAttribute(
                        "Mutations"
                    )
                )
            end
        end
    end

    --------------------------------------------------
    -- MUTATION-RELATED MODULES
    --------------------------------------------------

    for _, obj in ipairs(
        ReplicatedStorage:GetDescendants()
    ) do
        if obj:IsA("ModuleScript") then
            local lower =
                obj.Name:lower()

            if lower:find(
                "mutation",
                1,
                true
            ) then
                local ok, result =
                    pcall(require, obj)

                if ok
                    and typeof(result)
                        == "table"
                then
                    scanMutationTable(
                        result,
                        mutations
                    )
                end
            end
        end
    end

    --------------------------------------------------
    -- SORT
    --------------------------------------------------

    local result = {}

    for name in pairs(mutations) do
        result[#result + 1] =
            name
    end

    table.sort(result)

    return result
end

