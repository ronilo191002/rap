        else
            Button.Text =
                tostring(#selected)
                .. " Selected  ▼"
        end
    end

    local function clear()
        for _, child
            in ipairs(
                List:GetChildren()
            )
        do
            if child:IsA(
                "TextButton"
            ) then
                child:Destroy()
            end
        end
    end

    local function refresh()
        clear()

        local options =
            getOptions()

        if #options == 0 then
            local none =
                Instance.new(
                    "TextButton"
                )

            none.Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    32
                )

            none.BackgroundColor3 =
                Color3.fromRGB(
                    37,
                    37,
                    47
                )

            none.TextColor3 =
                Color3.fromRGB(
                    180,
                    180,
                    190
                )

            none.Text =
                "No mutations detected"

            none.Font =
                Enum.Font.Gotham

            none.TextSize = 12

            none.ZIndex = 101

            none.Parent =
                List

            return
        end

        for _, name
            in ipairs(options)
        do
            local option =
                Instance.new(
                    "TextButton"
                )

            option.Size =
                UDim2.new(
                    1,
                    0,
                    0,
                    32
                )

            option.BackgroundColor3 =
                Color3.fromRGB(
                    37,
                    37,
                    47
                )

            option.TextColor3 =
                Color3.fromRGB(
                    235,
                    235,
                    240
                )

            option.Font =
                Enum.Font.Gotham

            option.TextSize = 13

            option.ZIndex = 101

            option.Parent =
                List

            local corner =
                Instance.new(
                    "UICorner"
                )

            corner.CornerRadius =
                UDim.new(0, 6)

            corner.Parent =
                option

            local function update()
                if selectedTable[
                    name
                ] then
                    option.Text =
                        "✓  " .. name

                    option.BackgroundColor3 =
                        Color3.fromRGB(
                            82,
                            61,
                            160
                        )
                else
                    option.Text =
                        name

                    option.BackgroundColor3 =
                        Color3.fromRGB(
                            37,
                            37,
                            47
                        )
                end
            end

            option.MouseButton1Click:Connect(
                function()

                    selectedTable[
                        name
                    ] =
                        not selectedTable[
                            name
                        ]

                    if not selectedTable[
                        name
                    ] then
                        selectedTable[
                            name
                        ] = nil
                    end

                    update()

                    updateButton()
                end
            )

            update()
        end

        updateButton()
    end

    Button.MouseButton1Click:Connect(
        function()

            if OpenDropdown
                and OpenDropdown
                    ~= List
            then
                OpenDropdown.Visible =
                    false
            end

            List.Visible =
                not List.Visible

            if List.Visible then
                OpenDropdown =
                    List

                refresh()
            else
                OpenDropdown = nil
            end
        end
    )

    return {
        Button = Button,
        List = List,
        Refresh = refresh,
        UpdateButton = updateButton,
    }
end

