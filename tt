local function moveNearFruit(data)
    local root = getRoot()

    if not root then
        return false
    end

    local part =
        data.PositionObject

    if not part
        or not part.Parent
    then
        return false
    end

    root.CFrame =
        part.CFrame
        * CFrame.new(
            0,
            2.5,
            2
        )

    return true
end

--------------------------------------------------
-- PICK FRUIT
--------------------------------------------------

local function collectFruit(data)
    if not fireproximityprompt then
        Config.AutoCollect = false

        State.Status =
            "fireproximityprompt unsupported"

        return false
    end

    if not data
        or not data.Object
        or not data.Object.Parent
        or not data.Prompt
        or not data.Prompt.Parent
    then
        return false
    end

    moveNearFruit(data)

    task.wait(0.012)

    pcall(function()
        fireproximityprompt(
            data.Prompt,
            0
        )
    end)

    return true
end

--------------------------------------------------
-- FAST COLLECT BATCH
--------------------------------------------------

local function collectBatch(fruits)
    local root = getRoot()

    if not root then
        return
    end

    local originalPosition =
        root.CFrame

    State.Status =
        "Collecting "
        .. tostring(#fruits)
        .. " fruits..."

    for index, fruit in ipairs(fruits) do
        if not State.Running
            or not Config.AutoCollect
        then
            break
        end

        if fruit.Object
            and fruit.Object.Parent
            and fruit.Prompt
            and fruit.Prompt.Parent
        then
            State.Status =
                string.format(
                    "%s %.2f KG (%d/%d)",
                    fruit.DisplayName,
                    fruit.Weight,
                    index,
                    #fruits
                )

            collectFruit(fruit)

            State.Collected += 1

            task.wait(
                Config.PickupDelay
            )
        end
    end

    --------------------------------------------------
    -- RETURN
    --------------------------------------------------

    if root
        and root.Parent
    then
        root.CFrame =
            originalPosition
    end

    State.Status =
        "Scanning..."
end

