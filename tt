--------------------------------------------------
-- MUTATION PARSER
--------------------------------------------------

local function trim(text)
    return tostring(text)
        :gsub("^%s+", "")
        :gsub("%s+$", "")
end

local function parseMutations(value)
    local mutations = {}

    if value == nil then
        return mutations
    end

    --------------------------------------------------
    -- TABLE SUPPORT
    --------------------------------------------------

    if typeof(value) == "table" then
        for key, v in pairs(value) do
            local name

            if typeof(key) == "string"
                and (
                    v == true
                    or v == 1
                )
            then
                name = key

            elseif typeof(v) == "string" then
                name = v
            end

            if name then
                name = trim(name)

                if name ~= "" then
                    mutations[#mutations + 1] =
                        name
                end
            end
        end

        return mutations
    end

    --------------------------------------------------
    -- STRING SUPPORT
    --------------------------------------------------

    local text =
        trim(tostring(value))

    if text == ""
        or text == "None"
        or text == "Normal"
    then
        return mutations
    end

    --------------------------------------------------
    -- SUPPORT:
    -- Basa
    -- Basa,Gold
    -- Basa + Gold
    -- Basa|Gold
    -- Basa;Gold
    --------------------------------------------------

    text = text
        :gsub("%s*%+%s*", ",")
        :gsub("%s*;%s*", ",")
        :gsub("%s*|%s*", ",")

    for entry in text:gmatch("[^,]+") do
        entry = trim(entry)

        if entry ~= "" then
            mutations[#mutations + 1] =
                entry
        end
    end

    return mutations
end

--------------------------------------------------
-- POSITION OBJECT
--------------------------------------------------

local function getPositionObject(obj)
    if not obj then
        return nil
    end

    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    local parent = obj.Parent

    while parent
        and parent ~= Workspace
    do
        if parent:IsA("BasePart") then
            return parent
        end

        if parent:IsA("Model") then
            local part =
                parent.PrimaryPart
                or parent:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

            if part then
                return part
            end
        end

        parent = parent.Parent
    end

    return nil
end

--------------------------------------------------
-- FRUIT DATA
--------------------------------------------------

local function getFruitData(obj)
    if not obj then
        return nil
    end

    local fruitId =
        obj:GetAttribute("FruitId")

    local cropName =
        obj:GetAttribute("CropName")

    local weight =
        tonumber(
            obj:GetAttribute("Weight")
        )

    if fruitId == nil
        or cropName == nil
        or weight == nil
    then
        return nil
    end

    local prompt =
        obj:FindFirstChild(
            "HarvestPrompt"
        )

    if not prompt then
        prompt =
            obj:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            )
    end

    if not prompt
        or not prompt:IsA(
            "ProximityPrompt"
        )
    then
        return nil
    end

    local displayName =
        obj:GetAttribute("DisplayName")

    if displayName == nil
        or tostring(displayName) == ""
    then
        displayName = cropName
    end

    local mutationValue =
        obj:GetAttribute("Mutations")

    local mutations =
        parseMutations(
            mutationValue
        )

    return {
        Object = obj,

        Prompt = prompt,

        PositionObject =
            getPositionObject(obj),

        CropName =
            tostring(cropName),

        DisplayName =
            tostring(displayName),

        Weight = weight,

        FruitId = fruitId,

        PlantId =
            obj:GetAttribute("PlantId"),

        Mutations = mutations,

        MutationRaw =
            mutationValue,
    }
end

--------------------------------------------------
-- FRUIT FILTER
--------------------------------------------------

local function passesFruitFilter(data)
    if next(Config.Fruits) == nil then
        return true
    end

    return Config.Fruits[
        data.CropName
    ] == true
end

--------------------------------------------------
-- KG FILTER
--------------------------------------------------

local function passesKGFilter(data)
    local threshold =
        tonumber(
            Config.KGThreshold
        ) or 0

    if Config.KGRule == "Any KG" then
        return true
    end

    if Config.KGRule == "Above KG" then
        return data.Weight >= threshold
    end

    if Config.KGRule == "Below KG" then
        return data.Weight <= threshold
    end

    return true
end

--------------------------------------------------
-- MUTATION FILTER
--------------------------------------------------

local function mutationsToSet(list)
    local set = {}

    for _, name in ipairs(list) do
        set[
            tostring(name):lower()
        ] = true
    end

    return set
end

local function passesMutationFilter(data)
    local mutationCount =
        #data.Mutations

    --------------------------------------------------
    -- MUTATION COUNT
    --------------------------------------------------

    local wantedCount =
        tonumber(
            Config.MutationCount
        ) or 0

    if wantedCount > 0
        and mutationCount ~= wantedCount
    then
        return false
    end

    --------------------------------------------------
    -- CURRENT FRUIT MUTATIONS
    --------------------------------------------------

    local current =
        mutationsToSet(
            data.Mutations
        )

    --------------------------------------------------
    -- BLACKLIST
    -- any blacklisted mutation = reject
    --------------------------------------------------

    for mutation, enabled
        in pairs(
            Config.BlacklistMutations
        )
    do
        if enabled
            and current[
                tostring(mutation):lower()
            ]
        then
            return false
        end
    end

    --------------------------------------------------
    -- WHITELIST
    --
    -- Empty whitelist = allow everything.
    -- If whitelist has selections,
    -- fruit must contain at least ONE.
    --------------------------------------------------

    if next(
        Config.WhitelistMutations
    ) ~= nil then

        local matched = false

        for mutation, enabled
            in pairs(
                Config.WhitelistMutations
            )
        do
            if enabled
                and current[
                    tostring(mutation):lower()
                ]
            then
                matched = true
                break
            end
        end

        if not matched then
            return false
        end
    end

    return true
end

--------------------------------------------------
-- MATCHING FRUITS
--------------------------------------------------

local function getMatchingFruits()
    local plants = getPlants()

    if not plants then
        return {}
    end

    local list = {}
    local seen = {}

    for _, obj in ipairs(
        plants:GetDescendants()
    ) do
        local data =
            getFruitData(obj)

        if data then
            local key =
                tostring(data.PlantId)
                .. ":"
                .. tostring(data.FruitId)

            if not seen[key] then
                seen[key] = true

                if data.Prompt.Enabled
                    and passesFruitFilter(data)
                    and passesKGFilter(data)
                    and passesMutationFilter(data)
                then
                    list[#list + 1] =
                        data
                end
            end
        end
    end

    --------------------------------------------------
    -- HIGHEST KG FIRST
    --------------------------------------------------

    table.sort(
        list,
        function(a, b)
            return a.Weight > b.Weight
        end
    )

    return list
end

